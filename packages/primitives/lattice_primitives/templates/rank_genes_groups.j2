{% block user %}Ranked marker genes for each group in adata.obs['{{ params.get('groupby', 'leiden') }}'] using a one-vs-rest {{ params.get('method', 'wilcoxon') }} test; results are in adata.uns['rank_genes_groups'].{% endblock %}

{% block methods %}Marker genes were identified for each group with sc.tl.rank_genes_groups from Scanpy (groupby='{{ params.get('groupby', 'leiden') }}', method='{{ params.get('method', 'wilcoxon') }}'{% if params.get('method', 'wilcoxon') == 'wilcoxon' %}, tie_correct=True{% endif %}{% if params.get('method', 'wilcoxon') in ('wilcoxon', 't-test') %}, corr_method='benjamini-hochberg'{% endif %}, pts=True), comparing each group against all remaining cells [scanpy_rank_genes_groups]. P-values were adjusted for multiple testing using the Benjamini-Hochberg false-discovery-rate procedure.{% endblock %}
